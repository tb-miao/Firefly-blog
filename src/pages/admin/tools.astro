---
import { externalMomentsConfig } from "@/config/externalMomentsConfig";
import {
	toolListPageConfig,
	toolList,
	getEnabledTools,
	getAllToolTags,
} from "@/config/toollist";
import { toolsGistId, toolsFileName } from "@/utils/tools-gist";
import { readdirSync } from "fs";
import { join } from "path";

const tools = getEnabledTools();
const allTags = getAllToolTags();

const toolsImgDir = join(process.cwd(), "public", "assets", "images", "tools-img");
let availableIcons: string[] = [];
try {
	availableIcons = readdirSync(toolsImgDir).filter(f => /\.(png|jpg|jpeg|webp|ico|svg|gif)$/i.test(f));
} catch {
	availableIcons = [];
}

const GIST_ID = toolsGistId;
const FILE_NAME = toolsFileName;
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="icon" content="https://avatars.githubusercontent.com/u/172878250?v=4" />
  <link rel="icon" href="https://avatars.githubusercontent.com/u/172878250?v=4" />
  <title>工具管理</title>
  <style is:inline>
    :root {
      --bg: #fff; --card: transparent; --border: #d9d9d9; --text: #1a1a1a;
      --text-2: #595959; --text-3: #8c8c8c; --primary: #4d4d4d;
      --input-bg: transparent; --hover: #f5f5f5; --danger: #cf1322;
      --success: #389e0d; --code-bg: #f6f8fa;
    }
    :root.dark {
      --bg: #141414; --card: transparent; --border: #404040; --text: #e8e8e8;
      --text-2: #a6a6a6; --text-3: #737373; --input-bg: transparent;
      --hover: #262626; --primary: #d9d9d9; --code-bg: #1e1e1e;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Roboto', sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
      background: var(--bg); color: var(--text); min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .navbar {
      position: sticky; top: 0; z-index: 50;
      background: var(--bg); border-bottom: 1px solid var(--border);
    }
    .navbar-inner {
      max-width: 960px; margin: 0 auto; padding: 0 1rem;
      display: flex; align-items: center; justify-content: space-between; height: 48px;
    }
    .navbar-left { display: flex; align-items: center; gap: 0.5rem; }
    .navbar-left h1 { font-size: 0.9375rem; font-weight: 600; color: var(--text); }
    .nav-right { display: flex; align-items: center; gap: 0.5rem; }
    .back-link {
      display: inline-flex; align-items: center; gap: 0.25rem;
      color: var(--text-2); text-decoration: none; font-size: 0.8125rem;
      padding: 0.25rem 0.5rem; transition: color 0.15s;
    }
    .back-link:hover { color: var(--text); }
    .back-link svg { width: 16px; height: 16px; }
    .logout-btn {
      background: none; border: 1px solid var(--border); color: var(--text-3);
      padding: 0.25rem 0.5rem; font-size: 0.6875rem;
      cursor: pointer; transition: all 0.15s;
    }
    .logout-btn:hover { border-color: var(--danger); color: var(--danger); }

    .container { max-width: 960px; margin: 0 auto; padding: 1.25rem 1rem 4rem; }

    .card {
      background: var(--card); border: 1px solid var(--border);
      padding: 1.25rem; margin-bottom: 1rem;
    }

    .status-bar {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.5rem 0.75rem; margin-bottom: 1rem;
      border: 1px solid var(--border); font-size: 0.8125rem; color: var(--text-2);
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-dot.ok { background: var(--success); }
    .status-dot.err { background: var(--danger); }

    .field { margin-bottom: 1rem; }
    .field:last-child { margin-bottom: 0; }
    .field-label {
      display: flex; align-items: center; gap: 0.375rem;
      font-size: 0.75rem; font-weight: 500; color: var(--text-2);
      margin-bottom: 0.5rem;
    }
    .field-label .icon { font-size: 0.875rem; }

    .input-single {
      width: 100%; padding: 0.4rem 0.625rem; border: 1px solid var(--border);
      border-radius: 0; font-size: 0.8125rem; background: var(--input-bg);
      color: var(--text); outline: none; transition: border-color 0.15s;
    }
    .input-single:focus { border-color: var(--primary); }
    .input-single::placeholder { color: var(--text-3); }

    textarea {
      width: 100%; min-height: 80px; padding: 0.625rem 0.75rem;
      border: 1px solid var(--border); border-radius: 0;
      font-size: 0.875rem; line-height: 1.7; background: var(--input-bg);
      color: var(--text); outline: none; resize: vertical;
      font-family: inherit; transition: border-color 0.15s;
    }
    textarea:focus { border-color: var(--primary); }
    textarea::placeholder { color: var(--text-3); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.375rem;
      padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 0;
      font-size: 0.8125rem; font-weight: 500; cursor: pointer;
      transition: all 0.15s; font-family: inherit; background: var(--bg); color: var(--text);
    }
    .btn:hover { border-color: var(--primary); color: var(--primary); }
    .btn:active { background: var(--hover); }
    .btn-primary { background: var(--text); color: var(--bg); width: 100%; border-color: var(--text); }
    .btn-primary:hover { opacity: 0.85; color: var(--bg); }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-sm { padding: 0.25rem 0.625rem; font-size: 0.75rem; background: transparent; color: var(--text-2); border: 1px solid var(--border); }
    .btn-sm:hover { border-color: var(--primary); color: var(--primary); }
    .btn-danger-sm { padding: 0.25rem 0.5rem; font-size: 0.6875rem; background: transparent; color: var(--text-3); border: 1px solid var(--border); }
    .btn-danger-sm:hover { border-color: var(--danger); color: var(--danger); }

    .toggle-row {
      display: flex; align-items: center; justify-content: space-between;
      cursor: pointer; user-select: none;
    }
    .toggle-label {
      display: flex; align-items: center; gap: 0.375rem;
      font-size: 0.75rem; font-weight: 500; color: var(--text-2);
    }
    .toggle-checkbox { display: none; }
    .toggle-switch {
      position: relative; width: 36px; height: 20px;
      background: var(--border); border-radius: 10px;
      transition: background 0.15s; flex-shrink: 0;
    }
    .toggle-switch::after {
      content: ''; position: absolute; top: 2px; left: 2px;
      width: 16px; height: 16px; border-radius: 50%;
      background: #fff; transition: transform 0.15s;
    }
    .toggle-checkbox:checked + .toggle-switch { background: var(--primary); }
    .toggle-checkbox:checked + .toggle-switch::after { transform: translateX(16px); }

    .list-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .list-header .count { font-size: 0.75rem; color: var(--text-3); }

    .tool-row {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem;
      padding: 0.75rem 0; border-bottom: 1px solid var(--border);
    }
    .tool-row:last-child { border-bottom: none; }
    .tool-body { flex: 1; min-width: 0; }
    .tool-title { font-size: 0.875rem; font-weight: 600; color: var(--text); }
    .tool-desc { font-size: 0.75rem; color: var(--text-3); margin-top: 0.25rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .tool-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.375rem; font-size: 0.6875rem; color: var(--text-3); }
    .tool-meta .tag { padding: 0.125rem 0.375rem; background: var(--hover); border-radius: 4px; }
    .tool-meta .sep { opacity: 0.4; }
    .tool-actions { display: flex; gap: 0.25rem; flex-shrink: 0; }

    .empty-state { text-align: center; padding: 2rem 1rem; color: var(--text-3); }
    .empty-state .icon { font-size: 1.5rem; margin-bottom: 0.5rem; opacity: 0.4; }
    .empty-state p { font-size: 0.8125rem; }

    .toast {
      position: fixed; top: 60px; left: 50%; transform: translateX(-50%) translateY(-8px);
      padding: 0.5rem 1rem; font-size: 0.8125rem;
      font-weight: 500; z-index: 999; opacity: 0;
      transition: opacity 0.2s, transform 0.2s;
      pointer-events: none; border: 1px solid var(--border);
    }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
    .toast.ok { background: var(--success); color: #fff; border-color: var(--success); }
    .toast.err { background: var(--danger); color: #fff; border-color: var(--danger); }

    .dark-fab {
      position: fixed; bottom: 1.5rem; right: 1.5rem;
      width: 36px; height: 36px;
      background: var(--bg); border: 1px solid var(--border);
      cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center;
      transition: border-color 0.15s;
    }
    .dark-fab:hover { border-color: var(--primary); }

    .spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 1.5px solid var(--border); border-top-color: var(--primary);
      border-radius: 50%; animation: spin 0.6s linear infinite;
      vertical-align: middle; margin-right: 0.375rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .hidden { display: none !important; }
    .edit-bar { display: flex; gap: 0.5rem; margin-top: 0.75rem; }

    .icon-selector {
      display: flex; flex-wrap: wrap; gap: 0.5rem;
      max-height: 150px; overflow-y: auto;
      padding: 0.5rem; border: 1px solid var(--border);
    }
    .icon-option {
      width: 48px; height: 48px; border: 2px solid transparent;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      position: relative;
    }
    .icon-option:hover { border-color: var(--primary); }
    .icon-option.selected { border-color: var(--primary); background: var(--hover); }
    .icon-option.selected::after {
      content: '✓'; position: absolute; bottom: 0; right: 0;
      background: var(--primary); color: #fff; font-size: 0.6rem;
      width: 16px; height: 16px; border-radius: 0 0 0 4px;
      display: flex; align-items: center; justify-content: center;
    }
    .icon-option img { width: 40px; height: 40px; object-fit: contain; }
    .icon-option .url-label { font-size: 0.6rem; color: var(--text-3); text-align: center; }

    .preview-section {
      margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--border);
    }
    .preview-card {
      display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem;
      border: 1px solid var(--border); border-radius: 8px;
    }
    .preview-icon { width: 40px; height: 40px; border-radius: 8px; background: var(--hover); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .preview-icon img { width: 100%; height: 100%; object-fit: contain; }
    .preview-info { flex: 1; }
    .preview-title { font-size: 0.875rem; font-weight: 600; }
    .preview-desc { font-size: 0.75rem; color: var(--text-3); margin-top: 0.125rem; }
    .preview-tags { display: flex; gap: 0.25rem; margin-top: 0.25rem; }
    .preview-tag { font-size: 0.65rem; padding: 0.125rem 0.375rem; background: var(--hover); border-radius: 4px; color: var(--text-2); }

    .upload-area {
      border: 2px dashed var(--border); padding: 1rem; text-align: center;
      cursor: pointer; transition: border-color 0.15s;
    }
    .upload-area:hover { border-color: var(--primary); }
    .upload-area.dragover { border-color: var(--primary); background: var(--hover); }
    .upload-area input[type="file"] { display: none; }

    .form-errors {
      color: var(--danger); font-size: 0.75rem; margin-top: 0.375rem;
    }
    .form-errors ul { margin: 0; padding-left: 1rem; }

    @media (min-width: 768px) {
      .container { padding: 2rem 1.5rem 4rem; }
      .card { padding: 1.5rem; }
    }
    @media (max-width: 480px) {
      .navbar-inner { padding: 0 0.75rem; }
      .container { padding: 1rem 0.75rem 3rem; }
      .card { padding: 1rem; }
    }
  </style>
</head>
<body>

  <div id="admin-main">
    <nav class="navbar">
      <div class="navbar-inner">
        <div class="navbar-left">
          <span class="dot"></span>
          <h1>工具管理</h1>
        </div>
        <div class="nav-right">
          <a href="/admin/" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
            <span>后台</span>
          </a>
          <button class="logout-btn" onclick="doLogout()">退出</button>
        </div>
      </div>
    </nav>

    <div class="container">
      <!-- 连接状态 -->
      <div class="status-bar" id="status-bar">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-text">正在连接...</span>
      </div>

      <!-- Token 输入 -->
      <div class="card" id="token-card">
        <div class="field">
          <div class="field-label"><span class="icon">🔑</span> GitHub Token</div>
          <div style="display:flex;gap:0.5rem;">
            <input type="text" class="input-single" id="token-manual" placeholder="ghp_xxx 或 github_pat_xxx" autocomplete="off" style="flex:1;" />
            <button class="btn btn-sm" onclick="applyManualToken()">连接</button>
            <button class="btn btn-sm" id="disconnect-btn" onclick="disconnectToken()" style="display:none;">断开</button>
          </div>
          <div style="margin-top:0.5rem;font-size:0.75rem;color:var(--text-3);">
            Token 仅保存在浏览器本地，需要 <a href="https://github.com/settings/tokens/new?scopes=gist&description=tools-manager" target="_blank" style="color:var(--primary);">gist 权限</a>
          </div>
        </div>
      </div>

      <!-- 页面配置 -->
      <div class="card">
        <div class="field-label"><span class="icon">⚙️</span> 页面配置</div>
        <div class="field">
          <input type="text" class="input-single" id="page-title" placeholder="页面标题" />
        </div>
        <div class="field">
          <textarea id="page-desc" placeholder="页面描述"></textarea>
        </div>
        <div class="field">
          <label class="toggle-row" for="show-search-toggle">
            <span class="toggle-label"><span class="icon">🔍</span> 显示搜索框</span>
            <input type="checkbox" id="show-search-toggle" class="toggle-checkbox" />
            <span class="toggle-switch"></span>
          </label>
        </div>
        <div class="field">
          <label class="toggle-row" for="show-category-toggle">
            <span class="toggle-label"><span class="icon">🏷️</span> 显示分类筛选</span>
            <input type="checkbox" id="show-category-toggle" class="toggle-checkbox" />
            <span class="toggle-switch"></span>
          </label>
        </div>
        <button class="btn btn-primary" onclick="saveConfig()">保存页面配置</button>
      </div>

      <!-- 添加/编辑工具 -->
      <div class="card" id="editor-card">
        <div class="field-label"><span class="icon">➕</span> <span id="editor-title">添加工具</span></div>
        <div class="field">
          <div class="field-label">工具名称</div>
          <input type="text" class="input-single" id="tool-title" placeholder="输入工具名称" />
        </div>
        <div class="field">
          <div class="field-label">描述</div>
          <textarea id="tool-desc" placeholder="输入工具描述"></textarea>
        </div>
        <div class="field">
          <div class="field-label">链接地址</div>
          <input type="text" class="input-single" id="tool-url" placeholder="https://example.com/" />
        </div>
        <div class="field">
          <div class="field-label">标签（逗号分隔）</div>
          <input type="text" class="input-single" id="tool-tags" placeholder="开发工具, 效率工具" />
        </div>
        <div class="field">
          <div class="field-label">图标</div>
          <input type="text" class="input-single" id="tool-icon" placeholder="输入图标URL或选择下方图标" />
          <div style="margin-top:0.5rem;">
            <button class="btn btn-sm" onclick="toggleIconSelector()">📁 选择本地图标</button>
            <button class="btn btn-sm" onclick="toggleIconUrl()">🔗 使用URL图标</button>
          </div>
          <div class="hidden" id="icon-selector-panel" style="margin-top:0.5rem;">
            <div class="icon-selector" id="icon-selector"></div>
          </div>
          <div class="hidden" id="icon-url-panel" style="margin-top:0.5rem;">
            <div class="upload-area" id="upload-area" onclick="document.getElementById('icon-upload').click()">
              <div style="font-size:1.25rem;margin-bottom:0.25rem;">📤</div>
              <div style="font-size:0.75rem;color:var(--text-3);">点击或拖拽上传图标到 /assets/images/tools-img/</div>
              <input type="file" id="icon-upload" accept="image/*" onchange="handleIconUpload(this)" />
            </div>
          </div>
        </div>
        <div class="field">
          <label class="toggle-row" for="tool-enabled">
            <span class="toggle-label"><span class="icon">✅</span> 启用</span>
            <input type="checkbox" id="tool-enabled" class="toggle-checkbox" checked />
            <span class="toggle-switch"></span>
          </label>
        </div>
        <div class="preview-section">
          <div class="field-label"><span class="icon">👁️</span> 预览</div>
          <div class="preview-card" id="preview-card">
            <div class="preview-icon" id="preview-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="preview-info">
              <div class="preview-title" id="preview-title">工具名称</div>
              <div class="preview-desc" id="preview-desc">工具描述</div>
              <div class="preview-tags" id="preview-tags"></div>
            </div>
          </div>
        </div>
        <button class="btn btn-primary" id="submit-btn" onclick="submitTool()">保存工具</button>
        <div class="hidden" id="edit-bar">
          <button class="btn btn-sm" onclick="cancelEdit()" style="flex:1;">取消编辑</button>
        </div>
        <div class="form-errors hidden" id="form-errors"></div>
      </div>

      <!-- 工具列表 -->
      <div class="card">
        <div class="list-header">
          <div class="field-label" style="margin:0"><span class="icon">📋</span> 工具列表</div>
          <span class="count" id="list-count"></span>
        </div>
        <div id="tools-list">
          <div class="empty-state"><span class="spinner"></span></div>
        </div>
      </div>
    </div>
  </div>

  <button class="dark-fab" onclick="toggleDark()" title="切换暗色模式">🌙</button>
  <div class="toast" id="toast"></div>

  <script is:inline
    data-tools={JSON.stringify(toolList)}
    data-page-config={JSON.stringify(toolListPageConfig)}
    data-icons={JSON.stringify(availableIcons)}
    data-token={externalMomentsConfig.githubToken || ""}
    data-gist={toolsGistId}
    data-file="tools.json">
    var _script = document.currentScript;
    var TOOLS = JSON.parse(_script.getAttribute("data-tools") || "[]");
    var PAGE_CONFIG = JSON.parse(_script.getAttribute("data-page-config") || "{}");
    var AVAILABLE_ICONS = JSON.parse(_script.getAttribute("data-icons") || "[]");
    var ENV_TOKEN = _script.getAttribute("data-token") || "";
    var TOKEN = localStorage.getItem("gh_moments_token") || ENV_TOKEN || "";
    var GIST_ID = _script.getAttribute("data-gist") || "";
    var FILE_NAME = _script.getAttribute("data-file") || "tools.json";
    var API = "https://api.github.com";

    var editingIndex = null;

    function $(id) { return document.getElementById(id); }
    function esc(t) { var d = document.createElement("div"); d.textContent = t; return d.innerHTML; }
    function toast(msg, type) {
      var el = $("toast"); el.textContent = msg; el.className = "toast " + type + " show";
      clearTimeout(el._t); el._t = setTimeout(function() { el.className = "toast"; }, 2800);
    }
    function toggleDark() {
      document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
    }
    if (localStorage.getItem("theme") === "dark") document.documentElement.classList.add("dark");
    function doLogout() { sessionStorage.removeItem("admin_auth"); window.location.href = "/admin/"; }

    function setStatus(ok, text) {
      $("status-dot").className = "status-dot " + (ok ? "ok" : "err");
      $("status-text").textContent = text;
    }

    function applyManualToken() {
      var t = $("token-manual").value.trim();
      if (!t) { toast("请输入 Token", "err"); return; }
      TOKEN = t;
      localStorage.setItem("gh_moments_token", t);
      validateAndLoad();
    }

    function disconnectToken() {
      TOKEN = "";
      localStorage.removeItem("gh_moments_token");
      $("token-manual").value = "";
      $("disconnect-btn").style.display = "none";
      setStatus(false, "已断开，请重新输入 Token");
      $("tools-list").innerHTML = '<div class="empty-state"><div class="icon">🔧</div><p>暂无工具</p></div>';
    }

    function validateAndLoad() {
      if (!TOKEN) {
        setStatus(false, "请输入 Token 后点击连接");
        $("tools-list").innerHTML = '<div class="empty-state"><div class="icon">🔧</div><p>暂无工具</p></div>';
        return;
      }
      if (!GIST_ID) {
        setStatus(false, "未配置 Gist ID");
        return;
      }
      setStatus(false, "正在连接...");
      $("disconnect-btn").style.display = "none";
      fetch(API + "/gists/" + GIST_ID, {
        headers: { "Authorization": "Bearer " + TOKEN, "Accept": "application/vnd.github+json" }
      }).then(function(r) {
        if (r.ok) {
          setStatus(true, "已连接");
          $("disconnect-btn").style.display = "";
          loadTools();
        } else if (r.status === 401) {
          setStatus(false, "Token 无效或已过期");
        } else {
          setStatus(false, "连接失败（HTTP " + r.status + "）");
        }
      }).catch(function(e) {
        setStatus(false, "网络错误: " + e.message);
      });
    }

    function loadTools() {
      fetch(API + "/gists/" + GIST_ID, {
        headers: { "Authorization": "Bearer " + TOKEN, "Accept": "application/vnd.github+json" }
      }).then(function(r) { return r.json(); }).then(function(gist) {
        var file = gist.files[FILE_NAME];
        if (!file) {
          toast("Gist 中未找到 tools.json，将使用本地配置", "ok");
          renderTools();
          return;
        }
        try {
          var data = JSON.parse(file.content || "{}");
          if (data.tools && Array.isArray(data.tools)) {
            TOOLS = data.tools;
          }
          if (data.pageConfig) {
            PAGE_CONFIG = data.pageConfig;
            $("page-title").value = PAGE_CONFIG.title || "";
            $("page-desc").value = PAGE_CONFIG.description || "";
            $("show-search-toggle").checked = PAGE_CONFIG.showSearch !== false;
            $("show-category-toggle").checked = PAGE_CONFIG.showCategoryFilter !== false;
          }
          renderTools();
          toast("配置加载成功", "ok");
        } catch (e) {
          toast("配置解析失败: " + e.message, "err");
          renderTools();
        }
      }).catch(function(e) {
        toast("加载配置失败: " + e.message, "err");
        $("tools-list").innerHTML = '<div class="empty-state"><div class="icon">🔧</div><p>加载失败</p></div>';
      });
    }

    function saveConfigToGist() {
      var pageTitle = $("page-title").value.trim() || PAGE_CONFIG.title || "工具列表";
      var pageDesc = $("page-desc").value.trim() || PAGE_CONFIG.description || "我用过的工具吖~";
      var showSearch = $("show-search-toggle").checked;
      var showCategory = $("show-category-toggle").checked;

      var content = JSON.stringify({
        tools: TOOLS,
        pageConfig: {
          title: pageTitle,
          description: pageDesc,
          showSearch: showSearch,
          showCategoryFilter: showCategory
        }
      }, null, 2);

      return fetch(API + "/gists/" + GIST_ID, {
        method: "PATCH",
        headers: {
          "Authorization": "Bearer " + TOKEN,
          "Accept": "application/vnd.github+json",
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          files: { [FILE_NAME]: { content: content } }
        })
      }).then(function(r) {
        if (!r.ok) {
          return r.json().then(function(err) {
            throw new Error(err.message || "保存失败");
          });
        }
        return r.json();
      });
    }

    function saveConfig() {
      if (!TOKEN) { toast("请先连接 GitHub", "err"); return; }
      var btn = event.target;
      var originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = "保存中...";

      saveConfigToGist().then(function() {
        toast("页面配置已保存", "ok");
      }).catch(function(e) {
        toast("保存失败: " + e.message, "err");
      }).finally(function() {
        btn.disabled = false;
        btn.textContent = originalText;
      });
    }

    function toggleIconSelector() {
      $("icon-selector-panel").classList.remove("hidden");
      $("icon-url-panel").classList.add("hidden");
    }

    function toggleIconUrl() {
      $("icon-url-panel").classList.remove("hidden");
      $("icon-selector-panel").classList.add("hidden");
    }

    function selectIcon(src) {
      $("tool-icon").value = src;
      updatePreview();
    }

    function handleIconUpload(input) {
      var file = input.files[0];
      if (!file) return;
      if (!file.type.startsWith("image/")) {
        toast("请上传图片文件", "err");
        return;
      }
      var reader = new FileReader();
      reader.onload = function(e) {
        var base64 = e.target.result;
        var ext = file.name.split(".").pop() || "png";
        var fileName = "tools-img-" + Date.now() + "." + ext;
        $("tool-icon").value = "/assets/images/tools-img/" + fileName;
        updatePreview();
        toast("图片已预览，请手动将图片上传到 public/assets/images/tools-img/ 目录", "ok");
      };
      reader.readAsDataURL(file);
      input.value = "";
    }

    function updatePreview() {
      var title = $("tool-title").value || "工具名称";
      var desc = $("tool-desc").value || "工具描述";
      var icon = $("tool-icon").value;
      var tags = $("tool-tags").value.split(",").map(function(s) { return s.trim(); }).filter(Boolean);

      $("preview-title").textContent = title;
      $("preview-desc").textContent = desc;

      var iconEl = $("preview-icon");
      if (icon) {
        if (icon.startsWith("http")) {
          iconEl.innerHTML = '<img src="' + icon + '" alt="icon" onerror="this.parentElement.innerHTML=\'<svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; width=&quot;24&quot; height=&quot;24&quot;><path d=&quot;M22 11.08V12a10 10 0 1 1-5.93-9.14&quot;/><polyline points=&quot;22 4 12 14.01 9 11.01&quot;/></svg>\'">';
        } else {
          iconEl.innerHTML = '<img src="' + icon + '" alt="icon" onerror="this.parentElement.innerHTML=\'<svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot; width=&quot;24&quot; height=&quot;24&quot;><path d=&quot;M22 11.08V12a10 10 0 1 1-5.93-9.14&quot;/><polyline points=&quot;22 4 12 14.01 9 11.01&quot;/></svg>\'">';
        }
      } else {
        iconEl.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>';
      }

      var tagsEl = $("preview-tags");
      tagsEl.innerHTML = tags.map(function(t) {
        return '<span class="preview-tag">' + esc(t) + '</span>';
      }).join("");
    }

    function validateForm() {
      var errors = [];
      var title = $("tool-title").value.trim();
      var url = $("tool-url").value.trim();

      if (!title) errors.push("请输入工具名称");
      if (!url) errors.push("请输入工具链接");
      else if (!/^https?:\/\//i.test(url)) errors.push("链接格式不正确，请以 http:// 或 https:// 开头");

      var errorsEl = $("form-errors");
      if (errors.length) {
        errorsEl.innerHTML = '<ul>' + errors.map(function(e) { return '<li>' + e + '</li>'; }).join("") + '</ul>';
        errorsEl.classList.remove("hidden");
        return false;
      } else {
        errorsEl.classList.add("hidden");
        return true;
      }
    }

    function submitTool() {
      if (!TOKEN) { toast("请先连接 GitHub", "err"); return; }
      if (!validateForm()) return;

      var tool = {
        title: $("tool-title").value.trim(),
        description: $("tool-desc").value.trim(),
        url: $("tool-url").value.trim().replace(/`/g, ""),
        icon: $("tool-icon").value.trim().replace(/`/g, ""),
        tags: $("tool-tags").value.split(",").map(function(s) { return s.trim(); }).filter(Boolean),
        enabled: $("tool-enabled").checked,
      };

      var isEdit = editingIndex !== null;
      if (isEdit) {
        TOOLS[editingIndex] = tool;
      } else {
        TOOLS.push(tool);
      }

      var btn = $("submit-btn");
      var originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = "保存中...";

      saveConfigToGist().then(function() {
        toast(isEdit ? "已更新工具" : "已添加工具", "ok");
        cancelEdit();
        renderTools();
      }).catch(function(e) {
        toast("保存失败: " + e.message, "err");
        if (isEdit) {
          TOOLS.splice(editingIndex, 1);
        } else {
          TOOLS.pop();
        }
      }).finally(function() {
        btn.disabled = false;
        btn.textContent = isEdit ? "保存修改" : "保存工具";
      });
    }

    function cancelEdit() {
      editingIndex = null;
      $("tool-title").value = "";
      $("tool-desc").value = "";
      $("tool-url").value = "";
      $("tool-icon").value = "";
      $("tool-tags").value = "";
      $("tool-enabled").checked = true;
      $("editor-title").textContent = "添加工具";
      $("submit-btn").textContent = "保存工具";
      $("edit-bar").classList.add("hidden");
      $("form-errors").classList.add("hidden");
      updatePreview();
    }

    function editTool(index) {
      var tool = TOOLS[index];
      editingIndex = index;
      $("tool-title").value = tool.title;
      $("tool-desc").value = tool.description;
      $("tool-url").value = tool.url;
      $("tool-icon").value = tool.icon;
      $("tool-tags").value = (tool.tags || []).join(", ");
      $("tool-enabled").checked = tool.enabled !== false;
      $("editor-title").textContent = "编辑工具";
      $("submit-btn").textContent = "保存修改";
      $("edit-bar").classList.remove("hidden");
      updatePreview();
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function deleteTool(index) {
      if (!confirm("确定删除该工具？")) return;
      if (!TOKEN) { toast("请先连接 GitHub", "err"); return; }

      var tool = TOOLS[index];
      TOOLS.splice(index, 1);

      saveConfigToGist().then(function() {
        toast("已删除工具", "ok");
        renderTools();
      }).catch(function(e) {
        toast("删除失败: " + e.message, "err");
        TOOLS.splice(index, 0, tool);
        renderTools();
      });
    }

    function renderTools() {
      var list = $("tools-list");
      $("list-count").textContent = TOOLS.length + " 个";

      if (!TOOLS.length) {
        list.innerHTML = '<div class="empty-state"><div class="icon">🔧</div><p>暂无工具</p></div>';
        return;
      }

      list.innerHTML = "";
      TOOLS.forEach(function(tool, index) {
        var d = document.createElement("div");
        d.className = "tool-row";
        var tags = (tool.tags || []).map(function(t) { return '<span class="tag">' + esc(t) + '</span>'; }).join("");
        var enabledBadge = tool.enabled !== false ? '<span style="color:var(--success);">启用</span>' : '<span style="color:var(--danger);">禁用</span>';
        d.innerHTML =
          '<div class="tool-body">' +
          '<div class="tool-title">' + esc(tool.title) + '</div>' +
          '<div class="tool-desc">' + esc(tool.description) + '</div>' +
          '<div class="tool-meta">' + tags + (tags ? '<span class="sep">·</span>' : "") + enabledBadge + '</div>' +
          '</div>' +
          '<div class="tool-actions">' +
          '<button class="btn btn-sm" onclick="editTool(' + index + ')">编辑</button>' +
          '<button class="btn btn-danger-sm" onclick="deleteTool(' + index + ')">删除</button>' +
          '</div>';
        list.appendChild(d);
      });
    }

    function renderIconSelector() {
      var selector = $("icon-selector");
      selector.innerHTML = "";

      AVAILABLE_ICONS.forEach(function(fileName) {
        var path = "/assets/images/tools-img/" + fileName;
        var option = document.createElement("div");
        option.className = "icon-option";
        option.innerHTML = '<img src="' + path + '" alt="' + fileName + '" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<span class=\"url-label\">' + esc(fileName) + '</span>\'">';
        option.onclick = function() {
          document.querySelectorAll(".icon-option").forEach(function(o) { o.classList.remove("selected"); });
          option.classList.add("selected");
          selectIcon(path);
        };
        selector.appendChild(option);
      });
    }

    (function() {
      if (sessionStorage.getItem("admin_auth") !== "1") {
        window.location.href = "/admin/";
        return;
      }

      $("page-title").value = PAGE_CONFIG.title || "";
      $("page-desc").value = PAGE_CONFIG.description || "";
      $("show-search-toggle").checked = PAGE_CONFIG.showSearch !== false;
      $("show-category-toggle").checked = PAGE_CONFIG.showCategoryFilter !== false;

      if (TOKEN) {
        $("token-manual").value = TOKEN;
      }

      renderIconSelector();
      validateAndLoad();

      ["tool-title", "tool-desc", "tool-url", "tool-icon", "tool-tags"].forEach(function(id) {
        $(id).addEventListener("input", updatePreview);
      });

      $("tool-enabled").addEventListener("change", updatePreview);
    })();
  </script>
</body>
</html>